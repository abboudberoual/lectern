{
  "manifest_version": 3,
  "name": "Lectern",
  "short_name": "Lectern",
  "version": "1.2.0",
  "description": "Timestamped notes, transcripts and topic folders for the YouTube videos you learn from. Private, no account, bring your own AI.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Lectern",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "identity",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://mcp.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open the notebook panel"
    },
    "mark-moment": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mark the current moment in the video"
    }
  }
}
